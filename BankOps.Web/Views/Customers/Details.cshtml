@model BankOps.Web.Models.Banking.DTOs.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Details</h2>
            <p class="text-muted">@Model.CustomerNumber</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Customers
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h4>@Model.FirstName @Model.LastName</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Customer Number</dt>
                <dd class="col-sm-9">@Model.CustomerNumber</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(Model.Email ?? "Not provided")</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@(Model.PhoneNumber ?? "Not provided")</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@(Model.Address ?? "Not provided")</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @(Model.IsActive ? "Active" : "Inactive")
                </dd>
            </dl>

            @if (Model.IsActive)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Customer
                </a>
            }

        </div>
    </div>
</div>
