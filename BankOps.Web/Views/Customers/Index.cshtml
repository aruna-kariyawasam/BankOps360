@model IReadOnlyList<BankOps.Web.Models.Banking.DTOs.CustomerListItemViewModel>

@{
    ViewData["Title"] = "Customer Management";
    var search = ViewBag.Search as string ?? "";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Management</h2>
            <p class="text-muted">Manage registered bank customers.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Register Customer
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by customer number, name or email..." />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100">
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Customer Number</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No customers found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>@customer.CustomerNumber</td>

                                    <td>@customer.FullName</td>

                                    <td>@customer.Email</td>

                                    <td>@customer.PhoneNumber</td>

                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details"
                                               asp-route-id="@customer.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                            @if (customer.IsActive)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@customer.Id"
                                                   class="btn btn-sm btn-outline-dark">
                                                    Edit
                                                </a>
                                            }

                                            @if (customer.IsActive &&
                                           User.IsInRole("Administrator"))
                                            {
                                                <form asp-action="Deactivate"
                                                      asp-route-id="@customer.Id"
                                                      method="post">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Deactivate
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-muted mb-0">
                Total displayed customers: @Model.Count
            </p>

        </div>
    </div>
</div>
